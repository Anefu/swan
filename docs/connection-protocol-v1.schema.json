{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Anefu/swan/docs/connection-protocol-v1.schema.json",
  "title": "Swan connection wrapper output, protocol v1",
  "description": "One JSON object per line on stdout. A `device_code` line may precede the result during `login`; every invocation ends with exactly one `result` line.",
  "oneOf": [{ "$ref": "#/definitions/deviceCode" }, { "$ref": "#/definitions/result" }],
  "definitions": {
    "timestamp": { "type": "string", "format": "date-time" },
    "hostPattern": { "type": "string", "pattern": "^(\\*\\.)?[A-Za-z0-9.-]+(:[0-9]{1,5})?$" },
    "deviceCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "verificationUri", "userCode", "expiresAt"],
      "properties": {
        "type": { "const": "device_code" },
        "verificationUri": { "type": "string", "format": "uri" },
        "verificationUriComplete": { "type": "string", "format": "uri" },
        "userCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "expiresAt": { "$ref": "#/definitions/timestamp" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "state"],
      "properties": {
        "type": { "const": "result" },
        "state": { "enum": ["ready", "login_required", "error"] },
        "message": { "type": "string", "maxLength": 2000 },
        "expiresAt": { "$ref": "#/definitions/timestamp" },
        "credentials": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/credential" } },
        "files": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/file" } },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        }
      },
      "if": { "properties": { "state": { "const": "ready" } } },
      "then": { "required": ["credentials"] }
    },
    "credentialBase": {
      "type": "object",
      "required": ["name", "kind", "hosts"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "hosts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/hostPattern" } },
        "expiresAt": { "$ref": "#/definitions/timestamp" },
        "ca": { "type": "string", "pattern": "-----BEGIN CERTIFICATE-----" }
      }
    },
    "credential": {
      "allOf": [{ "$ref": "#/definitions/credentialBase" }],
      "oneOf": [
        {
          "properties": { "kind": { "const": "bearer" }, "value": { "type": "string", "minLength": 1 } },
          "required": ["value"]
        },
        {
          "properties": {
            "kind": { "const": "header" },
            "value": { "type": "string", "minLength": 1 },
            "inject": {
              "type": "object",
              "additionalProperties": false,
              "required": ["header", "format"],
              "properties": { "header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }, "format": { "type": "string", "pattern": "\\{value\\}" } }
            }
          },
          "required": ["value", "inject"]
        },
        {
          "properties": { "kind": { "const": "basic" }, "username": { "type": "string" }, "value": { "type": "string", "minLength": 1 } },
          "required": ["username", "value"]
        },
        {
          "properties": {
            "kind": { "const": "aws-sigv4" },
            "accessKeyId": { "type": "string", "minLength": 16 },
            "secretAccessKey": { "type": "string", "minLength": 1 },
            "sessionToken": { "type": "string" }
          },
          "required": ["accessKeyId", "secretAccessKey"]
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "pattern": "^~/(?!.*(^|/)\\.\\.(/|$)).+" },
        "content": { "type": "string", "maxLength": 262144 },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" }
      }
    }
  }
}
