# Sandbox image for Swan sessions (and the relay).
# Built by the harness with its local egress CA baked in; the tag includes the CA fingerprint.
# config.yaml can set the base image, package mirrors and extra root certificates (mirrors,
# caFiles): swan/setup.sh applies them before the first download. By default it does nothing.
ARG BASE_IMAGE=docker.io/library/node:22-bookworm-slim
FROM ${BASE_IMAGE}

COPY swan/ /tmp/swan/
# --error-on=any: stop at a source that cannot be fetched, with apt's reason, instead of failing
# later with "Unable to locate package".
RUN sh /tmp/swan/setup.sh \
 && apt-get update --error-on=any \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl file git jq less openssh-client procps python3 python3-pip \
      python3-venv ripgrep socat tree unzip xz-utils \
 && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/90swan-bootstrap-ca /tmp/swan \
 && python3 -m pip install --no-cache-dir --break-system-packages --cert /etc/ssl/certs/ca-certificates.crt uv \
 && git config --system safe.directory '*' \
 && git config --system init.defaultBranch main

# Trust the harness CA (used only for hosts that need credential injection).
COPY harness-ca.crt /usr/local/share/ca-certificates/persona-harness.crt
RUN update-ca-certificates

# The node image ships uid 1000 as "node"; rename it so prompts and paths read naturally.
RUN usermod -l agent -d /home/agent -m node && groupmod -n agent node \
 && mkdir -p /workspace /skills && chown agent:agent /workspace

# Extra tools from config.yaml (sandboxTools): packages, then the install script, as root with
# the proxy, mirrors and certificates above. Its own layer, so changing it rebuilds only from here.
ARG SWAN_PROXY
ARG SWAN_NO_PROXY
COPY swan-tools.sh /tmp/swan-tools.sh
RUN sh /tmp/swan-tools.sh && rm -f /tmp/swan-tools.sh

# The whole bundle: the harness CA plus any extra roots from caFiles.
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    UV_NATIVE_TLS=1 \
    NODE_USE_ENV_PROXY=1 \
    npm_config_update_notifier=false \
    npm_config_fund=false \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
