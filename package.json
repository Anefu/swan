{
  "name": "persona-harness",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @ph/server --filter @ph/desktop dev",
    "build": "pnpm --filter @ph/desktop build",
    "start": "pnpm --filter @ph/desktop start",
    "package": "pnpm --filter @ph/desktop package",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "aws-stub": "pnpm --filter @ph/aws-stub start"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
